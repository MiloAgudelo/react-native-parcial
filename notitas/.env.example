# Copy to .env and fill with your Supabase project (Settings → API).
# Use the Publishable key (sb_publishable_...), not the service_role secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# EAS Build (apk para compartir): las mismas variables deben existir en el proyecto Expo.
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "https://..."
# eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY --value "..."
# O: Expo dashboard → Project → Environment variables.

# Dev quick-login buttons (only shown when __DEV__ = true).
EXPO_PUBLIC_DEV_USER_A_EMAIL=
EXPO_PUBLIC_DEV_USER_A_PASSWORD=
EXPO_PUBLIC_DEV_USER_B_EMAIL=
EXPO_PUBLIC_DEV_USER_B_PASSWORD=
